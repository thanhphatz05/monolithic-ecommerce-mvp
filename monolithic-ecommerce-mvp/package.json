{
  "name": "monolithic-ecommerce-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "RESTful monolithic e-commerce MVP: Express + Prisma + PostgreSQL + JWT + Docker Compose",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "products:create": "node scripts/create-products.js",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.16.3",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2"
  },
  "devDependencies": {
    "prisma": "6.16.3"
  },
  "engines": {
    "node": ">=20"
  }
}
