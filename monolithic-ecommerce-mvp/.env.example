# Sao chép thành .env và đổi JWT_SECRET trước khi chạy
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce123
POSTGRES_DB=ecommerce
# URL cho lệnh Prisma chạy TRÊN MÁY HOST (Postgres container xuất ra 5433)
DATABASE_URL=postgresql://ecommerce:ecommerce123@localhost:5433/ecommerce?schema=public
JWT_SECRET=REPLACE_THIS_WITH_A_RANDOM_STRING_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d
PORT=3000
